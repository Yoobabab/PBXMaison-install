#!/usr/bin/env bash
# Serveur multi-tenant : mises à jour.
#   callikoe-autoupdate check    (chaque matin, callikoe-update.timer) : regarde s'il y a une nouvelle version publiée
#                                et l'écrit dans /var/lib/callikoe/update.json. N'installe rien : la console du serveur
#                                affiche une pastille sur « Mises à jour » et on installe d'un clic.
#   callikoe-autoupdate install  (bouton « Installer » de la console du serveur) : installe la dernière version,
#                                en attendant la fin des appels en cours (30 minutes au plus).
set -uo pipefail
export PATH="/usr/sbin:/usr/bin:/sbin:/bin"
LOG=/var/log/callikoe-update.log
STATE=/var/lib/callikoe/update.json
log() { echo "$(date '+%F %T') $*" >> "$LOG"; }
[[ -f /etc/callikoe/install.state ]] || exit 0
set -a; . /etc/callikoe/install.state; set +a
REPO="${REPO:-Yoobabab/PBXMaison-install}"; BRANCH="${REF:-main}"
# Version installée exactement (commit) : on suit la branche (main)
[[ "$BRANCH" =~ ^[0-9a-f]{40}$ ]] && BRANCH=main
install -d -m 0755 /var/lib/callikoe

check() {
  local json sha ver
  json="$(curl -fsS --max-time 20 -H "Accept: application/vnd.github+json" -H "User-Agent: Callikoe" "https://api.github.com/repos/${REPO}/commits/${BRANCH}" 2>/dev/null)" || {
    node -e 'const fs=require("fs");let s={};try{s=JSON.parse(fs.readFileSync(process.argv[1],"utf8"))}catch{};s.checked_at=new Date().toISOString();s.error="Vérification impossible (GitHub injoignable)";fs.writeFileSync(process.argv[1],JSON.stringify(s))' "$STATE"
    chmod 644 "$STATE"; return 1; }
  sha="$(printf '%s' "$json" | node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{try{process.stdout.write(JSON.parse(d).sha||"")}catch{}})')"
  [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || return 1
  ver="$(curl -fsS --max-time 20 "https://raw.githubusercontent.com/${REPO}/${sha}/VERSION" 2>/dev/null | head -c 40 | tr -d '\r\n ')"
  printf '%s' "$json" | node -e '
    const fs = require("fs"); let d = ""; process.stdin.on("data", (c) => d += c).on("end", () => {
      const j = JSON.parse(d), [state, current, version] = process.argv.slice(1);
      let prev = {}; try { prev = JSON.parse(fs.readFileSync(state, "utf8")); } catch {}
      const out = { checked_at: new Date().toISOString(), current, latest: j.sha, version: version || "?", date: j.commit?.committer?.date || "",
        message: String(j.commit?.message || "").split("\n")[0].slice(0, 200), available: !!current && j.sha !== current, installing: prev.installing || false };
      fs.writeFileSync(state, JSON.stringify(out));
    });' "$STATE" "${COMMIT:-}" "$ver"
  chmod 644 "$STATE"
}

case "${1:-check}" in
  check) check ;;
  install)
    check || true
    LATEST="$(node -e 'try{process.stdout.write(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).latest||"")}catch{}' "$STATE")"
    [[ "$LATEST" =~ ^[0-9a-f]{40}$ ]] || { log "Mise à jour : dernière version inconnue"; exit 1; }
    [[ "$LATEST" == "${COMMIT:-}" ]] && { log "Déjà à jour (${LATEST:0:7})"; exit 0; }
    # Pas pendant un appel : on attend qu'ils se terminent (30 minutes au plus)
    for ((i = 0; i < 60; i++)); do
      busy=0
      for conf in /etc/callikoe/t/*/asterisk/asterisk.conf; do
        [[ -f "$conf" ]] || continue
        n="$(asterisk -C "$conf" -rx "core show channels count" 2>/dev/null | awk '/active call/ {print $1; exit}')"
        [[ "${n:-0}" =~ ^[0-9]+$ ]] && (( n > 0 )) && busy=1
      done
      (( busy )) || break
      (( i == 0 )) && log "Nouvelle version ${LATEST:0:7} : appels en cours, installation dès qu'ils sont terminés"
      sleep 30
    done
    log "Mise à jour ${COMMIT:0:7} → ${LATEST:0:7}"
    if curl -fsSL --max-time 60 "https://raw.githubusercontent.com/${REPO}/${LATEST}/install.sh" -o /tmp/callikoe-install.sh \
       && PBXM_REF="$LATEST" bash /tmp/callikoe-install.sh >> "$LOG" 2>&1; then
      log "Mise à jour terminée (${LATEST:0:7})"
      set -a; . /etc/callikoe/install.state; set +a
      check || true
    else
      log "Échec de la mise à jour (voir ci-dessus)"
      rm -f /tmp/callikoe-install.sh; exit 1
    fi
    rm -f /tmp/callikoe-install.sh ;;
  *) echo "Usage : callikoe-autoupdate check | install" >&2; exit 2 ;;
esac
