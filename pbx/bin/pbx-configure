#!/usr/bin/env bash
# =============================================================================
#  pbx-configure — opérations système lancées par la console web (via sudo).
#  La console tourne sans droits root ; seules les actions ci-dessous lui sont permises.
#
#    pbx-configure apply <fichier>   applique un pbx-config.json déposé dans l'assistant
#    pbx-configure render            réécrit /etc/asterisk depuis les modèles (mise à jour)
#    pbx-configure dns               met à jour l'adresse <nom>.callikoe.fr (chaque jour, et au démarrage)
#    pbx-configure nginx             réécrit la config web (après obtention du certificat)
#    pbx-configure f2b status|ban <ip>|unban <ip>|settings <tentatives> <fenêtre min> <blocage min> <ip,ip…>
#                                    protection anti-intrusion (fail2ban), console : Sécurité
#    pbx-configure backup [--recordings] [--no-voicemail] [--keep N]   archive dans /var/lib/pbxmaison/backups
#    pbx-configure restore <fichier> restaure une archive (base, sons, messagerie, enregistrements)
#    pbx-configure update [ref] | update-status   mise à jour de Callikoe (relance l'installeur en arrière-plan)
#
#  Sortie : une ligne JSON par étape {"step":…, "status":"ok|warn|error|run", "message":…}
#  pour que la console affiche la progression.
# =============================================================================
set -Eeuo pipefail
export PATH="/usr/sbin:/usr/bin:/sbin:/bin"   # Node.js du système, pas une autre version installée ailleurs

APP=/opt/pbxmaison
ETC=/etc/pbxmaison
VAR=/var/lib/pbxmaison
STAGING="$VAR/staging"
TRUSTED_KEY="$APP/pbx/portal-public-key.pem"
[[ -f "$ETC/trusted-key.pem" ]] && TRUSTED_KEY="$ETC/trusted-key.pem"

json() { # json <étape> <statut> <message>
  node -e 'process.stdout.write(JSON.stringify({step:process.argv[1],status:process.argv[2],message:process.argv[3]})+"\n")' "$1" "$2" "$3"
}
fail() { json "$1" error "$2"; exit 1; }
trap 'json erreur error "Erreur inattendue ligne $LINENO : $BASH_COMMAND (voir journalctl -u pbxmaison-console)"' ERR

[[ $EUID -eq 0 ]] || { echo "pbx-configure doit être lancé en root" >&2; exit 2; }
set -a; . "$ETC/secrets.env"; . "$ETC/install.state"; set +a

# Port de la console d'administration (HTTPS) : séparé du 443 public (softphone, appli, téléphones)
ADMIN_PORT=8822
nginx_write() {
  local fqdn="${1:-}" tls="${2:-0}"
  install -d /var/www/letsencrypt
  {
    cat <<'EOF'
# PBXMaison — généré par pbx-configure
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
EOF
    if [[ "$tls" == 1 ]]; then
      local ssl="    ssl_certificate /etc/letsencrypt/live/${fqdn}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${fqdn}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security \"max-age=31536000\" always;
    server_tokens off;"
      local proxy='        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;'
      local ws='    location = /ws {
        proxy_pass http://127.0.0.1:8088/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }'
      cat <<EOF
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    server_tokens off;
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    # L'assistant ouvert en HTTP suit la fin de l'installation, puis bascule lui-même en HTTPS
    location = /api/setup/progress {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host \$host;
        proxy_set_header X-Forwarded-For \$remote_addr;
        proxy_set_header X-Forwarded-Proto http;
    }
    location ~ ^/(softphone|prov/|app/) { return 301 https://${fqdn}\$request_uri; }
    location / { return 301 https://${fqdn}:${ADMIN_PORT}\$request_uri; }
}
server {
    # 443 public : softphone web, appli mobile, provisionnement des téléphones. La console n'y est pas.
    # nginx 1.22 (Debian 12) et 1.24 (Ubuntu 24.04) : syntaxe « listen … http2 »
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name ${fqdn};
${ssl}
    client_max_body_size 2m;
${ws}
    location ~ ^/(softphone(\.js|\.css)?\$|style\.css\$|vendor/|phone/|prov/|app/|api/u/|api/health\$) {
${proxy}
    }
    location / { return 302 https://${fqdn}/softphone; }
}
server {
    # Console d'administration : port dédié, à réserver aux adresses de l'installateur (pare-feu ou Sécurité › Accès console)
    listen ${ADMIN_PORT} ssl http2;
    listen [::]:${ADMIN_PORT} ssl http2;
    server_name ${fqdn};
${ssl}
    client_max_body_size 2m;
    error_page 497 https://\$host:${ADMIN_PORT}\$request_uri;
${ws}
    location = /api/backups/upload {
        client_max_body_size 4g;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host \$host;
        proxy_set_header X-Forwarded-For \$remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
    location / {
${proxy}
    }
}
EOF
    else
      cat <<'EOF'
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    server_tokens off;
    client_max_body_size 2m;
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location = /ws {
        proxy_pass http://127.0.0.1:8088/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
    location = /api/backups/upload {
        client_max_body_size 4g;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto http;
    }
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
EOF
    fi
  } > /etc/nginx/sites-available/pbxmaison
  ln -sf /etc/nginx/sites-available/pbxmaison /etc/nginx/sites-enabled/pbxmaison
  rm -f /etc/nginx/sites-enabled/default
  nginx -t -q
  if systemctl is-active --quiet nginx; then systemctl reload nginx; else systemctl enable --now nginx >/dev/null 2>&1; fi
}

# ---------------------------------------------------------------------------
# Adresses gérées <nom>.callikoe.fr : créées et mises à jour par le service DNS Callikoe
DNS_API="${PBXM_DNS_API:-https://api.callikoe.fr}"
is_managed_fqdn() { [[ "$1" =~ \.callikoe\.(fr|com)$ ]]; }
# Affiche l'IP enregistrée (code 0) ou le message d'erreur (code 1)
dns_register() {
  local body out
  body="$(node -e 'const fs=require("fs");process.stdout.write(JSON.stringify({config:JSON.parse(fs.readFileSync(process.argv[1],"utf8"))}))' "$ETC/pbx-config.json")"
  if ! out="$(curl -4 -sS --max-time 25 -X POST "$DNS_API/v1/register" -H "content-type: application/json" --data-binary "$body" 2>&1)"; then
    echo "service ${DNS_API} injoignable (${out})"; return 1
  fi
  node -e 'let r;try{r=JSON.parse(process.argv[1])}catch{console.log("réponse illisible");process.exit(1)}
    if(r.ok){console.log(r.ip);process.exit(0)}console.log(r.error||"erreur");process.exit(1)' "$out"
}

# Port SIP : 5060 (par défaut) ou 5160 ; SIP_BOTH=1 pendant une transition (les deux ports ouverts)
SIP_PORT=5060; SIP_BOTH=0
[[ -f "$ETC/sip-ports" ]] && . "$ETC/sip-ports"
[[ "$SIP_PORT" == 5160 ]] || SIP_PORT=5060
SIP_TLS_PORT=$((SIP_PORT + 1)); SIP_OTHER=$((SIP_PORT == 5160 ? 5060 : 5160))
export SIP_PORT SIP_BOTH

# Transport SIP TLS (port 5061 ou 5161 ; l'autre aussi pendant une transition), si le certificat existe
write_tls_transport() {
  [[ -f /etc/asterisk/keys/fullchain.pem ]] || { rm -f /etc/asterisk/pjsip_tls.conf; return 0; }
  local ports="$SIP_TLS_PORT" name="transport-tls" p
  ((SIP_BOTH == 1)) && ports="$SIP_TLS_PORT $((SIP_OTHER + 1))"
  : > /etc/asterisk/pjsip_tls.conf
  for p in $ports; do
    cat >> /etc/asterisk/pjsip_tls.conf <<EOF
[${name}]
type = transport
protocol = tls
bind = 0.0.0.0:${p}
cert_file = /etc/asterisk/keys/fullchain.pem
priv_key_file = /etc/asterisk/keys/privkey.pem
method = tlsv1_2
symmetric_transport = yes
external_media_address = ${PUBLIC_IP}
external_signaling_address = ${PUBLIC_IP}

EOF
    name="transport-tls-legacy"
  done
  chown asterisk:asterisk /etc/asterisk/pjsip_tls.conf
}

# Pare-feu : ouvre les ports SIP utilisés (et ferme les autres une fois la transition terminée)
fw_sip_ports() {
  local udp="$SIP_PORT" tcp="$SIP_PORT, $SIP_TLS_PORT"
  ((SIP_BOTH == 1)) && { udp="5060, 5160"; tcp="5060, 5061, 5160, 5161"; }
  if [[ -f /etc/nftables.conf ]] && grep -q 'comment "SIP UDP"' /etc/nftables.conf; then
    sed -i -E "s/^( *)udp dport .* accept comment \"SIP UDP\"/\1udp dport { ${udp} } accept comment \"SIP UDP\"/; s/^( *)tcp dport .* accept comment \"SIP TCP\/TLS\"/\1tcp dport { ${tcp} } accept comment \"SIP TCP\/TLS\"/" /etc/nftables.conf
    nft -c -f /etc/nftables.conf && nft -f /etc/nftables.conf
  elif command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q "Status: active"; then
    local p
    for p in 5060 5160; do
      if [[ "$p" == "$SIP_PORT" ]] || ((SIP_BOTH == 1)); then ufw allow "$p/udp" >/dev/null; ufw allow "$p:$((p + 1))/tcp" >/dev/null
      else ufw delete allow "$p/udp" >/dev/null 2>&1 || true; ufw delete allow "$p:$((p + 1))/tcp" >/dev/null 2>&1 || true; fi
    done
  fi
}

# Écrit /etc/asterisk à partir des modèles (variables de pbx.env, secrets.env, install.state)
render_asterisk() {
  install -d -o asterisk -g asterisk -m 0750 /etc/asterisk /etc/asterisk/keys
  node "$APP/pbx/lib/render-asterisk.mjs" "$APP/pbx/asterisk" /etc/asterisk
  local ind=us
  case "$PBX_COUNTRY" in FR|MC|LU) ind=fr ;; BE) ind=be ;; CH) ind=ch ;; esac
  sed "s/^country=.*/country=${ind}/" /usr/share/asterisk/indications.conf.sample > /etc/asterisk/indications.conf
  cp /usr/share/asterisk/musiconhold.conf.sample /etc/asterisk/musiconhold.conf
  # Musiques d'attente des files (console : Gestion d'appels › Files d'attente)
  printf '\n#tryinclude /var/lib/pbxmaison/musiconhold_callikoe.conf\n' >> /etc/asterisk/musiconhold.conf
  write_tls_transport
  chown -R asterisk:asterisk /etc/asterisk
}

cmd_apply() {
  local src="${1:-}"
  [[ -n "$src" ]] || fail verification "Fichier manquant."
  src="$(readlink -f "$src")"
  [[ "$src" == "$STAGING/"* && -f "$src" ]] || fail verification "Fichier refusé (emplacement non autorisé)."

  # 1. Vérification de la licence
  json verification run "Vérification de la signature et de la licence…"
  local out
  if ! out="$(node "$APP/pbx/lib/verify-config.mjs" "$src" "$TRUSTED_KEY" --env "$ETC/pbx.env.new" 2>&1)"; then
    fail verification "$(printf '%s' "$out" | sed 's/^ *//' | tr '\n' ' ')"
  fi
  if [[ -f "$ETC/pbx.env" ]]; then
    local old_id new_id
    old_id="$(. "$ETC/pbx.env"; echo "$PBX_ID")"; new_id="$(. "$ETC/pbx.env.new"; echo "$PBX_ID")"
    [[ "$old_id" == "$new_id" ]] || { rm -f "$ETC/pbx.env.new"; fail verification "Ce serveur est déjà configuré pour un autre PBX."; }
  fi
  mv "$ETC/pbx.env.new" "$ETC/pbx.env"; chmod 644 "$ETC/pbx.env"
  install -m 0644 "$src" "$ETC/pbx-config.json"
  set -a; . "$ETC/pbx.env"; set +a
  json verification ok "Licence ${PBX_LICENSE_KEY} valide · ${PBX_MAX_CALLS} appels simultanés · ${PBX_FQDN}"

  # 2. Configuration d'Asterisk
  json asterisk run "Configuration du moteur téléphonique…"
  render_asterisk
  json asterisk ok "Configuration écrite (IP publique ${PUBLIC_IP}, langue ${PBX_LANGUAGE})"

  # 3. Fuseau horaire
  if [[ "${IS_WSL:-0}" != 1 ]]; then timedatectl set-timezone "$PBX_TIMEZONE" 2>/dev/null || true; fi

  # 4. DNS et certificat
  local dns_ip="" dns_ok=0 tls=0
  if is_managed_fqdn "$PBX_FQDN"; then
    json dns run "Création de l'adresse ${PBX_FQDN}…"
    local reg_ip
    if reg_ip="$(dns_register)"; then
      json dns ok "Adresse ${PBX_FQDN} → ${reg_ip} (créée automatiquement)"
      dns_ip="$reg_ip"; sleep 5   # le temps que les serveurs DNS de Cloudflare la publient
    else
      json dns warn "Adresse automatique non créée : ${reg_ip}"
    fi
  fi
  [[ -n "$dns_ip" ]] || dns_ip="$(dig +short A "$PBX_FQDN" 2>/dev/null | grep -E '^[0-9.]+$' | tail -n1 || true)"
  if [[ "$dns_ip" == "$PUBLIC_IP" ]]; then
    dns_ok=1
    json certificat run "Demande du certificat HTTPS pour ${PBX_FQDN}…"
    nginx_write "" 0
    if timeout 180 certbot certonly --webroot -w /var/www/letsencrypt -d "$PBX_FQDN" -m "$PBX_ADMIN_EMAIL" --agree-tos -n -q; then
      install -d /etc/letsencrypt/renewal-hooks/deploy
      cat > /etc/letsencrypt/renewal-hooks/deploy/pbxmaison <<EOF
#!/bin/sh
install -o asterisk -g asterisk -m 0640 /etc/letsencrypt/live/${PBX_FQDN}/fullchain.pem /etc/asterisk/keys/fullchain.pem
install -o asterisk -g asterisk -m 0600 /etc/letsencrypt/live/${PBX_FQDN}/privkey.pem /etc/asterisk/keys/privkey.pem
/usr/sbin/asterisk -rx "module reload res_pjsip.so" >/dev/null 2>&1 || true
systemctl reload nginx
EOF
      chmod 755 /etc/letsencrypt/renewal-hooks/deploy/pbxmaison
      install -o asterisk -g asterisk -m 0640 "/etc/letsencrypt/live/${PBX_FQDN}/fullchain.pem" /etc/asterisk/keys/fullchain.pem
      install -o asterisk -g asterisk -m 0600 "/etc/letsencrypt/live/${PBX_FQDN}/privkey.pem" /etc/asterisk/keys/privkey.pem
      write_tls_transport
      tls=1
      json certificat ok "Certificat obtenu : https://${PBX_FQDN}:${ADMIN_PORT} (console) et SIP TLS (${SIP_TLS_PORT})"
    else
      json certificat warn "Certificat refusé par Let's Encrypt : le port 80 doit être joignable depuis Internet. Relance l'assistant une fois corrigé."
    fi
  elif [[ -z "$dns_ip" ]]; then
    json certificat warn "${PBX_FQDN} ne pointe nulle part : crée un enregistrement DNS A vers ${PUBLIC_IP}, puis relance l'assistant pour obtenir le certificat."
  else
    json certificat warn "${PBX_FQDN} pointe vers ${dns_ip} au lieu de ${PUBLIC_IP} : corrige le DNS, puis relance l'assistant pour obtenir le certificat."
  fi
  nginx_write "$PBX_FQDN" "$tls"

  # 5. Démarrage d'Asterisk
  json demarrage run "Démarrage du moteur téléphonique…"
  systemctl enable asterisk >/dev/null 2>&1
  systemctl restart asterisk
  for _ in $(seq 1 30); do /usr/sbin/asterisk -rx "core show version" >/dev/null 2>&1 && break; sleep 1; done
  /usr/sbin/asterisk -rx "core show version" >/dev/null 2>&1 || fail demarrage "Asterisk ne démarre pas (journalctl -u asterisk)."
  local transports
  transports="$(/usr/sbin/asterisk -rx "pjsip show transports" | awk '/^Transport:/ && $2 !~ /^</ {print $2}' | paste -sd' ' -)"
  json demarrage ok "Moteur démarré · transports : ${transports:-aucun}"

  # 6. Code d'installation pour le portail
  local machine
  machine="$(printf '%s:%s' "$(cat /etc/machine-id 2>/dev/null || hostname)" "$PBX_ID" | sha256sum | cut -c1-16)"
  ACT_PBX_ID="$PBX_ID" ACT_LICENSE_KEY="$PBX_LICENSE_KEY" ACT_FQDN="$PBX_FQDN" \
  ACT_PUBLIC_IP="$PUBLIC_IP" ACT_LOCAL_IP="${LOCAL_IP:-}" ACT_BEHIND_NAT="${BEHIND_NAT:-0}" ACT_DNS_OK="$dns_ok" \
  ACT_TLS="$tls" ACT_WSL="${IS_WSL:-0}" ACT_OS="${OS_NAME:-}" ACT_ASTERISK="$(/usr/sbin/asterisk -V 2>/dev/null)" \
  ACT_MACHINE="$machine" node "$APP/pbx/lib/activation.mjs" encode-env > "$ETC/activation.txt"
  chmod 644 "$ETC/activation.txt"
  cat > "$ETC/setup.state" <<EOF
DNS_OK=$dns_ok
TLS=$tls
CONFIGURED_AT='$(date -Is)'
EOF
  chmod 644 "$ETC/setup.state"
  rm -f "$src"
  json termine ok "$(cat "$ETC/activation.txt")"
}

# ----------------------------------------------------------------------------- Anti-intrusion
F2B_JAIL=/etc/fail2ban/jail.d/pbxmaison.conf
valid_ip() { [[ "$1" =~ ^[0-9a-fA-F:.]{3,45}(/[0-9]{1,3})?$ ]]; }
f2b_banned() { # f2b_banned <jail> → IP séparées par des espaces
  fail2ban-client status "$1" 2>/dev/null | sed -n 's/.*Banned IP list:[[:space:]]*//p' | tr -s ' \t' ' ' || true
}
f2b_write() { # f2b_write <maxretry> <findtime min> <bantime min> <ignoreip séparés par des virgules>
  local ignore="127.0.0.1/8 ::1 ${4//,/ }"
  cat > "$F2B_JAIL" <<EOF
# Callikoe — écrit par la console (Sécurité). Ne pas modifier à la main.
[asterisk]
enabled  = true
backend  = auto
filter   = asterisk
logpath  = /var/log/asterisk/security
           /var/log/asterisk/messages
maxretry = $1
findtime = $2m
bantime  = $3m
banaction = %(banaction_allports)s
ignoreip = ${ignore}

# SSH : lu dans le journal systemd (Debian 12 n'a pas /var/log/auth.log : sans ça fail2ban ne démarre pas)
[sshd]
enabled  = true
backend  = systemd

# Adresses bloquées à la main depuis la console : blocage permanent
[callikoe-manual]
enabled  = true
backend  = auto
filter   = callikoe-manual
logpath  = /var/log/pbxmaison-manual-ban.log
maxretry = 1
bantime  = -1
banaction = %(banaction_allports)s
ignoreip = 127.0.0.1/8 ::1
EOF
  printf '[Definition]\nfailregex = ^CALLIKOE-NEVER-MATCH <HOST>$\nignoreregex =\n' > /etc/fail2ban/filter.d/callikoe-manual.conf
  touch /var/log/pbxmaison-manual-ban.log
}
cmd_f2b() {
  command -v fail2ban-client >/dev/null || { echo '{"ok":false,"error":"fail2ban n'"'"'est pas installé"}'; exit 0; }
  case "${1:-status}" in
    status)
      local auto manual active=0
      systemctl is-active --quiet fail2ban && active=1
      auto="$(f2b_banned asterisk)"; manual="$(f2b_banned callikoe-manual)"
      F2B_ACTIVE="$active" F2B_AUTO="$auto" F2B_MANUAL="$manual" node -e '
        const sp = (s) => (s || "").trim().split(/\s+/).filter(Boolean);
        process.stdout.write(JSON.stringify({ ok: true, active: process.env.F2B_ACTIVE === "1", auto: sp(process.env.F2B_AUTO), manual: sp(process.env.F2B_MANUAL) }) + "\n");' ;;
    ban)   valid_ip "${2:-}" || { echo '{"ok":false,"error":"Adresse invalide"}'; exit 1; }
           grep -q callikoe-manual "$F2B_JAIL" 2>/dev/null || { f2b_write 5 10 60 ""; fail2ban-client reload >/dev/null 2>&1 || systemctl restart fail2ban; sleep 1; }
           fail2ban-client set callikoe-manual banip "$2" >/dev/null && echo '{"ok":true}' ;;
    unban) valid_ip "${2:-}" || { echo '{"ok":false,"error":"Adresse invalide"}'; exit 1; }
           fail2ban-client unban "$2" >/dev/null 2>&1 || true; echo '{"ok":true}' ;;
    settings)
      [[ "${2:-}" =~ ^[0-9]+$ && "${3:-}" =~ ^[0-9]+$ && "${4:-}" =~ ^[0-9]+$ ]] || { echo '{"ok":false,"error":"Réglages invalides"}'; exit 1; }
      local ip; IFS=',' read -ra list <<< "${5:-}"
      for ip in "${list[@]}"; do [[ -z "$ip" ]] || valid_ip "$ip" || { echo '{"ok":false,"error":"Adresse invalide"}'; exit 1; }; done
      f2b_write "$2" "$3" "$4" "${5:-}"
      fail2ban-client reload >/dev/null 2>&1 || systemctl restart fail2ban
      echo '{"ok":true}' ;;
    *) echo "Usage : pbx-configure f2b status|ban <ip>|unban <ip>|settings …" >&2; exit 2 ;;
  esac
}

# ----------------------------------------------------------------------------- Sauvegarde / restauration
BK_DIR="$VAR/backups"
cmd_backup() {
  local rec=0 vm=1 keep=7
  while [[ $# -gt 0 ]]; do
    case "$1" in --recordings) rec=1 ;; --no-voicemail) vm=0 ;; --keep) keep="${2:-7}"; shift ;; esac; shift
  done
  [[ "$keep" =~ ^[0-9]+$ ]] || keep=7
  install -d -m 2750 -o root -g pbxmaison "$BK_DIR"
  local name tmp
  name="callikoe-$(date +%Y%m%d-%H%M%S).tar.gz"
  tmp="$(mktemp -d)"
  json base run "Export de la base de données…"
  runuser -u postgres -- pg_dump --clean --if-exists asterisk > "$tmp/database.sql" || { rm -rf "$tmp"; fail base "Export de la base impossible."; }
  json base ok "Base exportée"
  mkdir -p "$tmp/etc" "$tmp/var"
  for f in pbx.env pbx-config.json activation.txt setup.state install.state; do [[ -f "$ETC/$f" ]] && cp -a "$ETC/$f" "$tmp/etc/"; done
  tar -C "$VAR" --exclude=./backups --exclude=./staging -cf - . | tar -C "$tmp/var" -xf -
  ((vm)) && [[ -d /var/spool/asterisk/voicemail ]] && cp -a /var/spool/asterisk/voicemail "$tmp/voicemail"
  ((rec)) && [[ -d /var/spool/asterisk/monitor/callikoe ]] && cp -a /var/spool/asterisk/monitor/callikoe "$tmp/recordings"
  printf '{"format":1,"created_at":"%s","version":"%s","commit":"%s","voicemail":%s,"recordings":%s}\n' \
    "$(date -Is)" "$(cat "$APP/VERSION" 2>/dev/null || echo ?)" "${COMMIT:-}" "$( ((vm)) && echo true || echo false)" "$( ((rec)) && echo true || echo false)" > "$tmp/manifest.json"
  tar -C "$tmp" -czf "$BK_DIR/$name" .
  rm -rf "$tmp"
  chown root:pbxmaison "$BK_DIR/$name"; chmod 640 "$BK_DIR/$name"
  # Conservation : les N plus récentes
  ls -1t "$BK_DIR"/callikoe-*.tar.gz 2>/dev/null | tail -n +"$((keep + 1))" | xargs -r rm -f
  json termine ok "$name"
}
cmd_restore() {
  local src="${1:-}"
  src="$(readlink -f "$src" 2>/dev/null || true)"
  [[ -f "$src" && ( "$src" == "$BK_DIR/"* || "$src" == "$STAGING/"* ) ]] || fail verification "Fichier refusé (emplacement non autorisé)."
  local tmp; tmp="$(mktemp -d)"
  json verification run "Lecture de l'archive…"
  tar -C "$tmp" -xzf "$src" || { rm -rf "$tmp"; fail verification "Archive illisible."; }
  [[ -f "$tmp/manifest.json" && -f "$tmp/database.sql" ]] || { rm -rf "$tmp"; fail verification "Ce fichier n'est pas une sauvegarde Callikoe."; }
  if [[ -f "$ETC/pbx.env" && -f "$tmp/etc/pbx.env" ]]; then
    local a b; a="$(. "$ETC/pbx.env"; echo "$PBX_ID")"; b="$(. "$tmp/etc/pbx.env"; echo "$PBX_ID")"
    [[ "$a" == "$b" ]] || { rm -rf "$tmp"; fail verification "Cette sauvegarde vient d'un autre PBX ($b)."; }
  fi
  json verification ok "Sauvegarde valide"
  json base run "Restauration de la base de données…"
  systemctl stop asterisk 2>/dev/null || true
  runuser -u postgres -- psql -q -v ON_ERROR_STOP=0 asterisk < "$tmp/database.sql" >/dev/null 2>&1 || true
  json base ok "Base restaurée"
  json fichiers run "Restauration des fichiers…"
  [[ -d "$tmp/var" ]] && cp -a "$tmp/var/." "$VAR/"
  for f in pbx.env pbx-config.json activation.txt setup.state; do [[ -f "$tmp/etc/$f" ]] && cp -a "$tmp/etc/$f" "$ETC/$f"; done
  if [[ -d "$tmp/voicemail" ]]; then rm -rf /var/spool/asterisk/voicemail; cp -a "$tmp/voicemail" /var/spool/asterisk/voicemail; fi
  if [[ -d "$tmp/recordings" ]]; then install -d -o asterisk -g asterisk -m 2770 /var/spool/asterisk/monitor; cp -a "$tmp/recordings/." /var/spool/asterisk/monitor/callikoe/; fi
  chown -R asterisk:asterisk /var/spool/asterisk/voicemail /var/spool/asterisk/monitor 2>/dev/null || true
  rm -rf "$tmp"
  json fichiers ok "Fichiers restaurés"
  if [[ -f "$ETC/pbx.env" ]]; then set -a; . "$ETC/pbx.env"; set +a; render_asterisk; fi
  systemctl start asterisk 2>/dev/null || true
  # La console redémarre juste après avoir répondu (elle régénère alors le plan de numérotation)
  systemd-run --on-active=3 --unit="pbxmaison-restart-$$" systemctl restart pbxmaison-console >/dev/null 2>&1 || true
  json termine ok "Restauration terminée : la console redémarre."
}

# ----------------------------------------------------------------------------- Mise à jour
UPD_LOG=/var/log/pbxmaison-update.log
cmd_update() {
  local ref="${1:-${REF:-main}}" repo="${REPO:-Yoobabab/PBXMaison-install}"
  [[ "$ref" =~ ^[A-Za-z0-9._/-]{1,80}$ && "$repo" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || { echo '{"ok":false,"error":"Version invalide"}'; exit 1; }
  if systemctl is-active --quiet pbxmaison-update 2>/dev/null; then echo '{"ok":true,"running":true}'; exit 0; fi
  : > "$UPD_LOG"; chmod 644 "$UPD_LOG"
  systemd-run --unit=pbxmaison-update --collect --setenv=PBXM_REF="$ref" --setenv=PBXM_REPO="$repo" /bin/bash -c \
    "set -o pipefail; curl -fsSL https://raw.githubusercontent.com/${repo}/${ref}/install.sh | bash >> $UPD_LOG 2>&1; echo \"FIN code=\$?\" >> $UPD_LOG" >/dev/null
  echo '{"ok":true,"running":true}'
}
# Port SIP (console : Sécurité › Port SIP) : set <5060|5160> <0|1 transition> · status (appareils encore sur l'ancien port)
cmd_sip_port() {
  case "${1:-status}" in
    set)
      local port="${2:-}" both="${3:-0}" i
      [[ "$port" == 5060 || "$port" == 5160 ]] && [[ "$both" == 0 || "$both" == 1 ]] || { echo '{"ok":false,"error":"Réglage invalide."}'; exit 1; }
      printf 'SIP_PORT=%s\nSIP_BOTH=%s\n' "$port" "$both" > "$ETC/sip-ports.new"; chmod 644 "$ETC/sip-ports.new"; mv "$ETC/sip-ports.new" "$ETC/sip-ports"
      SIP_PORT="$port"; SIP_BOTH="$both"; SIP_TLS_PORT=$((SIP_PORT + 1)); SIP_OTHER=$((SIP_PORT == 5160 ? 5060 : 5160)); export SIP_PORT SIP_BOTH
      set -a; . "$ETC/pbx.env"; set +a
      render_asterisk >/dev/null
      fw_sip_ports >/dev/null 2>&1 || true
      # Les ports SIP ne changent qu'au redémarrage du moteur : il attend la fin des appels en cours
      local up0 up
      up0="$(/usr/sbin/asterisk -rx "core show uptime seconds" 2>/dev/null | awk '/System uptime/ {print $3}')"; up0="${up0:-999999999}"
      /usr/sbin/asterisk -rx "core restart when convenient" >/dev/null 2>&1 || systemctl restart asterisk
      for i in $(seq 1 45); do
        sleep 2
        up="$(/usr/sbin/asterisk -rx "core show uptime seconds" 2>/dev/null | awk '/System uptime/ {print $3}')" || true
        [[ -n "$up" ]] && ((up < up0)) || continue
        if /usr/sbin/asterisk -rx "pjsip show transports" 2>/dev/null | grep -q "0.0.0.0:${SIP_PORT}\b" \
          && { ((SIP_BOTH == 0)) || /usr/sbin/asterisk -rx "pjsip show transports" 2>/dev/null | grep -q "0.0.0.0:${SIP_OTHER}\b"; } \
          && ! { ((SIP_BOTH == 0)) && /usr/sbin/asterisk -rx "pjsip show transports" 2>/dev/null | grep -q "0.0.0.0:${SIP_OTHER}\b"; }; then
          echo "{\"ok\":true,\"restarted\":true,\"port\":${SIP_PORT},\"both\":${SIP_BOTH}}"; return 0
        fi
      done
      echo "{\"ok\":true,\"restarted\":false,\"port\":${SIP_PORT},\"both\":${SIP_BOTH}}" ;;
    status)
      local live="" legacy=""
      live="$(/usr/sbin/asterisk -rx "pjsip show transports" 2>/dev/null | grep -oE '0\.0\.0\.0:[0-9]+' | cut -d: -f2 | sort -u | paste -sd, -)" || true
      if ((SIP_BOTH == 1)); then
        command -v conntrack >/dev/null || apt-get install -y -q --no-install-recommends conntrack >/dev/null 2>&1 || true
        if command -v conntrack >/dev/null; then
          legacy="$( { conntrack -L -p udp --dport "$SIP_OTHER" 2>/dev/null; conntrack -L -p tcp --dport "$SIP_OTHER" 2>/dev/null; conntrack -L -p tcp --dport "$((SIP_OTHER + 1))" 2>/dev/null; } \
            | awk -v me1="${PUBLIC_IP:-}" -v me2="${LOCAL_IP:-}" '{ proto=$1; src=""; sp=""; dp=""; for (i=1;i<=NF;i++) { if ($i ~ /^src=/ && src=="") src=substr($i,5); if ($i ~ /^sport=/ && sp=="") sp=substr($i,7); if ($i ~ /^dport=/ && dp=="") dp=substr($i,7) }
                    if (src != "" && src != me1 && src != me2 && src != "127.0.0.1") printf "%s{\"proto\":\"%s\",\"ip\":\"%s\",\"port\":%s,\"to\":%s}", (n++ ? "," : ""), proto, src, sp, dp }')" || true
        fi
      fi
      echo "{\"port\":${SIP_PORT},\"both\":${SIP_BOTH},\"listening\":[${live}],\"legacy\":[${legacy}]}" ;;
    *) echo '{"ok":false,"error":"Action inconnue."}'; exit 1 ;;
  esac
}

# Capture réseau des appels (SIP + audio RTP) au format pcap, lisible dans Wireshark
CAPDIR="$VAR/captures"
cmd_capture() {
  install -d -o pbxmaison -g pbxmaison -m 0750 "$CAPDIR"
  case "${1:-status}" in
    start)
      local secs="${2:-60}" mode="${3:-sip}" filter name
      [[ "$secs" =~ ^[0-9]+$ ]] && ((secs >= 5 && secs <= 600)) || { echo '{"ok":false,"error":"Durée : entre 5 et 600 secondes."}'; exit 1; }
      pgrep -f "tcpdump.*$CAPDIR" >/dev/null && { echo '{"ok":false,"error":"Une capture est déjà en cours."}'; exit 1; }
      command -v tcpdump >/dev/null || apt-get install -y -q --no-install-recommends tcpdump >/dev/null 2>&1 || { echo '{"ok":false,"error":"tcpdump introuvable."}'; exit 1; }
      filter="port 5060 or port 5061 or port 5160 or port 5161"
      [[ "$mode" == all ]] && filter="$filter or (udp portrange 10000-20000)"
      name="capture-$(date +%Y%m%d-%H%M%S)-${mode}.pcap"
      # Détachée : la console récupère la main tout de suite ; fichier rendu lisible par la console à la fin
      setsid bash -c "timeout $secs tcpdump -i any -n -s 0 -c 500000 -Z root -w '$CAPDIR/$name' $filter >/dev/null 2>&1; chown pbxmaison:pbxmaison '$CAPDIR/$name'; chmod 640 '$CAPDIR/$name'" </dev/null >/dev/null 2>&1 &
      # Garde 20 captures au plus
      { ls -1t "$CAPDIR"/capture-*.pcap 2>/dev/null | tail -n +21 | xargs -r rm -f; } || true
      echo "{\"ok\":true,\"file\":\"$name\",\"seconds\":$secs}" ;;
    stop) pkill -INT -f "tcpdump.*$CAPDIR" || true; sleep 1; chown pbxmaison:pbxmaison "$CAPDIR"/*.pcap 2>/dev/null || true; echo '{"ok":true}' ;;
    status) if pgrep -f "tcpdump.*$CAPDIR" >/dev/null; then echo '{"running":true}'; else echo '{"running":false}'; fi ;;
    *) echo '{"ok":false,"error":"Action inconnue."}'; exit 1 ;;
  esac
}

cmd_update_status() {
  local active=0; systemctl is-active --quiet pbxmaison-update 2>/dev/null && active=1
  UPD_ACTIVE="$active" node -e '
    const fs = require("fs"); let log = ""; try { log = fs.readFileSync(process.argv[1], "utf8"); } catch {}
    const lines = log.replace(/\x1b\[[0-9;]*m/g, "").split("\n").filter(Boolean);
    const end = lines.findLast((l) => /^FIN code=/.test(l));
    process.stdout.write(JSON.stringify({ running: process.env.UPD_ACTIVE === "1", done: !!end, ok: end ? end === "FIN code=0" : null, log: lines.slice(-60) }) + "\n");' "$UPD_LOG"
}

# ----------------------------------------------------------------------------- Système (tableau de bord)
cmd_firewall_check() {
  # Vérification locale : services à l'écoute + ports ouverts dans le pare-feu (nftables ou ufw)
  local ruleset="" fw="none"
  if command -v nft >/dev/null && nft list ruleset 2>/dev/null | grep -q "table inet pbxmaison"; then fw="nftables"; ruleset="$(nft list ruleset 2>/dev/null)"
  elif command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q "Status: active"; then fw="ufw"; ruleset="$(ufw status 2>/dev/null)"; fi
  FW="$fw" RULES="$ruleset" SP="$SIP_PORT" LISTEN="$(ss -H -lntu 2>/dev/null)" node -e '
    const listen = process.env.LISTEN || "", rules = process.env.RULES || "", fw = process.env.FW;
    const isListening = (proto, port) => listen.split("\n").some((l) => { const f = l.trim().split(/\s+/); return f[0] === proto && new RegExp(`:${port}$`).test(f[4] || ""); });
    const opened = (proto, port) => fw === "none" ? null : fw === "ufw" ? new RegExp(`(^|\\s)${port}(:\\d+)?(/${proto})?\\s+ALLOW`, "m").test(rules) || new RegExp(`${port.split("-")[0]}:\\d+/${proto}`).test(rules)
      : new RegExp(`${proto} dport \\{?[^\\n]*\\b${port.split("-")[0]}\\b`).test(rules);
    const sp = Number(process.env.SP) || 5060;
    const checks = [[`SIP (UDP ${sp})`, "udp", String(sp)], [`SIP (TCP ${sp})`, "tcp", String(sp)], [`SIP chiffré TLS (TCP ${sp + 1})`, "tcp", String(sp + 1)],
      ["Audio RTP (UDP 10000-20000)", "udp", "10000-20000"], ["Console web HTTP (TCP 80)", "tcp", "80"], ["Softphone, appli et téléphones HTTPS (TCP 443)", "tcp", "443"], ["Console d’administration HTTPS (TCP 8822)", "tcp", "8822"]];
    const out = checks.map(([label, proto, port]) => ({ label, proto, port, listening: port.includes("-") ? null : isListening(proto, port), open: opened(proto, port) }));
    process.stdout.write(JSON.stringify({ ok: true, firewall: fw, checks: out }) + "\n");'
}

case "${1:-}" in
  apply) shift; cmd_apply "$@" ;;
  firewall-check) cmd_firewall_check ;;
  restart-services)
    systemctl restart asterisk && json services ok "Moteur téléphonique redémarré"
    systemctl restart fail2ban 2>/dev/null || true
    systemctl reload nginx 2>/dev/null || true
    systemd-run --on-active=2 --unit="pbxmaison-restart-$$" systemctl restart pbxmaison-console >/dev/null 2>&1 || true
    json termine ok "Services redémarrés : la console revient dans quelques secondes" ;;
  reboot)
    systemd-run --on-active=5 --unit="pbxmaison-reboot-$$" systemctl reboot >/dev/null 2>&1
    json termine ok "Redémarrage du serveur dans 5 secondes" ;;
  f2b) shift; cmd_f2b "$@" ;;
  backup) shift; cmd_backup "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  update) shift; cmd_update "$@" ;;
  update-status) cmd_update_status ;;
  capture) shift; cmd_capture "$@" ;;
  sip-port) shift; cmd_sip_port "$@" ;;
  dns)    [[ -f "$ETC/pbx.env" ]] || exit 0
          set -a; . "$ETC/pbx.env"; set +a
          is_managed_fqdn "$PBX_FQDN" || { echo "Adresse ${PBX_FQDN} non gérée par Callikoe : rien à faire."; exit 0; }
          if ip="$(dns_register)"; then
            echo "Adresse ${PBX_FQDN} → ${ip}"
            [[ "$ip" == "${PUBLIC_IP:-}" ]] || echo "Attention : l'IP publique a changé (${PUBLIC_IP:-?} → ${ip}). Relance la commande d'installation pour mettre à jour la téléphonie." >&2
          else echo "Échec : ${ip}" >&2; exit 1; fi ;;
  license) # Nouvelle clé de licence (portail) : vérifiée, écrite dans pbx.env, appliquée au moteur sans coupure
          src="$(readlink -f "${2:-}")"
          [[ "$src" == "$STAGING/"* && -f "$src" ]] || { echo '{"ok":false,"error":"Fichier refusé."}'; exit 1; }
          rc=0; res="$(node "$APP/pbx/lib/license-token.mjs" "$src" "$TRUSTED_KEY" "$ETC/pbx.env")" || rc=$?; rm -f "$src"
          echo "$res"; ((rc == 0)) || exit 1
          set -a; . "$ETC/pbx.env"; set +a; render_asterisk >/dev/null 2>&1 || true
          /usr/sbin/asterisk -rx "dialplan reload" >/dev/null 2>&1 || true ;;
  render) [[ -f "$ETC/pbx.env" ]] || { echo "PBX pas encore configuré" >&2; exit 1; }
          set -a; . "$ETC/pbx.env"; set +a; render_asterisk ;;
  nginx) set -a; . "$ETC/pbx.env" 2>/dev/null || true; set +a
         if [[ -n "${PBX_FQDN:-}" && -f "/etc/letsencrypt/live/${PBX_FQDN}/fullchain.pem" ]]; then nginx_write "$PBX_FQDN" 1; else nginx_write "" 0; fi ;;
  *) echo "Usage : pbx-configure apply <fichier> | license <fichier> | render | dns | nginx | f2b … | backup | restore <fichier> | update | update-status" >&2; exit 2 ;;
esac
